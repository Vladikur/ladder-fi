# Copy to .env.local and fill in. chmod 600 .env.local. Never commit it.

# --- Signer ---
# 'env': PRIVATE_KEY below is used directly.
# 'keystore': KEYSTORE_PATH points at a V3 (Web3 Secret Storage) JSON keystore file;
#             SIGNER_KEYSTORE_PASSWORD is used if set, otherwise you're prompted on stdin
#             (only works when the process is attached to a real TTY).
SIGNER_MODE=env
PRIVATE_KEY=
# KEYSTORE_PATH=./keystore.json
# SIGNER_KEYSTORE_PASSWORD=

# --- CSRF ---
# Any random secret, 16+ chars. Required on every request (see lib/guards/csrf.ts).
APP_TOKEN=

# Only set to true if you have TLS terminated in front of this app AND you understand
# that means the private key becomes reachable from wherever that TLS endpoint is
# reachable from. Leave false for local-only use.
ALLOW_PUBLIC_BIND=false

# --- Guard-rails (checked server-side on every /api/execute call, TZ §5) ---
# Checked first, unconditionally. Set true to hard-stop all execution.
KILL_SWITCH=false

# Raw USDG units (6 decimals), e.g. 1000000000 = 1000 USDG. 0 = unlimited.
# Only applies to deposits that touch USDG on one leg - see lib/registry/chains.ts.
MAX_NOTIONAL_PER_RUN=0
MAX_NOTIONAL_PER_DAY=0

MAX_SLIPPAGE_BPS=200
MAX_POSITIONS_PER_RUN=50
MAX_GAS_PER_RUN=50000000

# --- Audit ---
AUDIT_LOG_PATH=./audit.jsonl
