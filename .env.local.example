# Copy to .env.local and fill in. chmod 600 .env.local. Never commit it.

# --- CSRF ---
# Any random secret, 16+ chars. Required on every request (see lib/guards/csrf.ts).
# This app is non-custodial - it never holds a private key - but this token still
# defends against other sites driving this app's API and popping wallet-signature
# prompts from your browser.
APP_TOKEN=

# Only set to true once you have TLS terminated in front of this app (e.g. behind a
# reverse proxy). Leave false for local-only use.
ALLOW_PUBLIC_BIND=false
